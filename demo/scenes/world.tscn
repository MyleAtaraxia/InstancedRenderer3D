[gd_scene format=3 uid="uid://7evstgekap24"]

[sub_resource type="GDScript" id="GDScript_e5uuo"]
script/source = "extends Node3D

@export var mesh: Mesh
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var size := 64
	print(\"instance count: \", size**3)
	for x in size: for y in size: for z in size: 
		var instance = InstancedMesh3D.new()
		instance.mesh = mesh
		add_child(instance)
		var pos = Vector3(x,y,z) * 10
		instance.position = pos
		instance.is_static = false
"

